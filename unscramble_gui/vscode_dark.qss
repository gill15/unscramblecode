/* VS Code Dark+ inspired theme (approx) */

* {
  font-size: 13px;
}

QWidget {
  background: #1e1e1e;
  color: #d4d4d4;
}

QLabel {
  color: #d4d4d4;
}

QGroupBox {
  border: 1px solid #2a2a2a;
  border-radius: 8px;
  margin-top: 10px;
  padding: 10px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 6px;
  color: #c8c8c8;
}

QLineEdit, QSpinBox, QTextEdit {
  background: #252526;
  border: 1px solid #3c3c3c;
  border-radius: 6px;
  padding: 6px 8px;
  selection-background-color: #264f78;
  selection-color: #ffffff;
}

QTextEdit {
  border-radius: 8px;
}

QPushButton {
  background: #0e639c;
  color: #ffffff;
  border: 1px solid #0e639c;
  border-radius: 6px;
  padding: 6px 10px;
}

QPushButton:hover {
  background: #1177bb;
  border-color: #1177bb;
}

QPushButton:pressed {
  background: #0b4f7a;
  border-color: #0b4f7a;
}

QPushButton:disabled {
  background: #3a3d41;
  border-color: #3a3d41;
  color: #9da5b4;
}

QPushButton:checked {
  background: #3a3d41;
  border-color: #3a3d41;
  color: #d4d4d4;
}

QTabWidget::pane {
  border: 1px solid #2a2a2a;
  border-radius: 8px;
  top: -1px;
}

QTabBar::tab {
  background: #252526;
  color: #d4d4d4;
  border: 1px solid #2a2a2a;
  border-bottom: none;
  padding: 8px 14px;
  margin-right: 4px;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
}

QTabBar::tab:selected {
  background: #1e1e1e;
  border-color: #3c3c3c;
}

QTabBar::tab:hover:!selected {
  background: #2d2d2d;
}

QScrollBar:vertical {
  border: none;
  background: #1e1e1e;
  width: 12px;
  margin: 0px;
}

QScrollBar::handle:vertical {
  background: #424242;
  min-height: 20px;
  border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
  background: #4f4f4f;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}

